# Copy this file to .env and adjust values for your machine/environment.
# .env is gitignored - .env.sample is the checked-in reference.

# Target ERPForce environment the whole suite drives.
BASE_URL=https://dev.erpforce.co

# Playwright worker count. Kept at 1 by default because many inventory specs
# build on data created by earlier ones in the same run (see CLAUDE.md) -
# only raise this if you know the specs you're running don't share state.
WORKERS=1
